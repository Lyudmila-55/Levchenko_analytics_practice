  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Manager" name="Менеджер проекта">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateProject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProjectComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Task_SetupWorkspace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TeamNotified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateReports</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Команда">
        <bpmn:flowNodeRef>Task_AcceptTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseWork</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Поступил запрос на проект">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_ProjectComplete" name="Проект завершен">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="Event_TeamNotified" name="Команда уведомлена">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="Event_Deadline" name="Срок истек" attachedToRef="Task_ExecuteWork">
      <bpmn:outgoing>Flow_Escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:intermediateCatchEvent id="Event_DataReceived" name="Данные получены">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_CreateProject" name="Создать проект" zeebe:formDefinition="projectForm">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AssignTask" name="Назначить задачу" zeebe:formDefinition="taskAssignmentForm">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewResults" name="Проверить результаты">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SetupWorkspace" name="Настроить рабочее пространство" zeebe:taskDefinition="setupWorkspace">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GenerateReports" name="Сформировать отчеты">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_AcceptTask" name="Принять задачу">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ExecuteWork" name="Выполнить работу">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SubmitResults" name="Отправить результаты">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviseWork" name="Доработать задание">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approve" name="Результаты утверждены?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_CheckData" name="Данные корректны?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CreateProject" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CreateProject" targetRef="Task_SetupWorkspace" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SetupWorkspace" targetRef="Task_AssignTask" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AssignTask" targetRef="Event_TeamNotified" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_TeamNotified" targetRef="Task_AcceptTask" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_AcceptTask" targetRef="Task_ExecuteWork" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ExecuteWork" targetRef="Event_DataReceived" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_DataReceived" targetRef="Task_GenerateReports" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_GenerateReports" targetRef="Task_ReviewResults" />
    <bpmn:sequenceFlow id="Flow_10" name="Да" sourceRef="Gateway_Approve" targetRef="EndEvent_ProjectComplete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ReviewResults" targetRef="Gateway_Approve" />
    <bpmn:sequenceFlow id="Flow_12" name="Да" sourceRef="Gateway_CheckData" targetRef="Task_SubmitResults">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SubmitResults" targetRef="Gateway_CheckData" />
    <bpmn:sequenceFlow id="Flow_14" name="Нет" sourceRef="Gateway_Approve" targetRef="Task_ReviseWork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=!approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ReviseWork" targetRef="Task_ExecuteWork" />
    <bpmn:sequenceFlow id="Flow_16" name="Нет" sourceRef="Gateway_CheckData" targetRef="Task_ReviseWork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=!valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Escalate" sourceRef="Event_Deadline" targetRef="Task_ReviewResults" />
  </bpmn:process>
