@startuml C4 Container Diagram
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Container Diagram — Система управления проектами

Person(manager, "Менеджер проекта", "Создаёт проекты, назначает задачи")
Person(member, "Участник команды", "Выполняет задачи")
Person(admin, "Администратор", "Управляет системой")

System_Boundary(s1, "ProjectFlow") {
  Container(web_app, "Веб-приложение", "React", "Пользовательский интерфейс")
  Container(api_gateway, "API Gateway", "Java", "Единая точка входа для API")
  
  Container(auth_service, "Сервис аутентификации", "Node.js", "Управление пользователями и доступом")
  Container(project_service, "Сервис проектов", "Spring Boot", "Логика управления проектами")
  Container(task_service, "Сервис задач", "Python", "Управление задачами и сроками")
  Container(notification_service, "Сервис уведомлений", "Python", "Отправка email и push-уведомлений")
  
  ContainerDb(database, "База Данных", "PostgreSQL", "Хранение структурированных данных")
}

System_Ext(email_system, "Email сервис", "SendGrid/SMTP")

Rel(manager, web_app, "Использует", "HTTPS")
Rel(member, web_app, "Использует", "HTTPS")
Rel(admin, web_app, "Использует", "HTTPS")

Rel(web_app, api_gateway, "Вызывает API", "REST/HTTPS")
Rel(api_gateway, auth_service, "Аутентификация", "JWT")
Rel(api_gateway, project_service, "Управление проектами", "gRPC")
Rel(api_gateway, task_service, "Управление задачами", "gRPC")

Rel(auth_service, database, "Хранит данные пользователей")
Rel(project_service, database, "Чтение/запись проектов")
Rel(task_service, database, "Чтение/запись задач")

Rel(task_service, notification_service, "События задач")
Rel(notification_service, email_system, "Отправка писем")
@enduml