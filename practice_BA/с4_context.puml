@startuml c4_context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4 Context Diagram — Система управления проектами

Person(manager, "Менеджер проекта", "Создает проекты, назначает задачи, контролирует выполнение")
Person(member, "Участник команды", "Выполняет задачи, участвует в обсуждениях")
Person(admin, "Администратор", "Управляет пользователями и настройками системы")

System(projectflow, "projectFlow", "Платформа для управления проектами и командной работы")

Rel(manager, projectflow, "Управляет проектами")
Rel(member, projectflow, "Работает с задачами")
Rel(admin, projectflow, "Администрирует систему")

System_Ext(email, "Email сервис", "Внешний сервис электронной почты")
Rel(projectflow, email, "Отправляет уведомления")
@enduml